# --- OpenRouter credentials -------------------------------------------------
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Model ------------------------------------------------------------------
# Qwen3.7 Flash via OpenRouter. Overrides default_model in
# hermes_a2a_config.json. Chosen for cost: a six-agent run costs about $0.0014
# against $0.147 on moonshotai/kimi-k3 -- roughly 100x cheaper for the same
# grounded answers. Verified alternatives: deepseek/deepseek-v4-flash-0731,
# openai/gpt-oss-120b (see the lab README for what each was tested on).
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_TEMPERATURE=0.2
# Qwen3.7 Flash reasons before it answers, and reasoning shares this budget with
# the visible reply. 1200 was not enough: reasoning consumed it and some agents
# returned nothing at all. Keep this generous for any reasoning model.
OPENROUTER_MAX_TOKENS=6000
# Reasoning effort: none | low | medium | high | default.
# 'medium' is the workshop default: measured fastest AND cheapest of the three
# levels on this lab's prompts. See BENCHMARK.md.
OPENROUTER_REASONING_EFFORT=medium

# --- Attribution shown on the OpenRouter dashboard --------------------------
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=AgentMart Workshop

# --- Logging ----------------------------------------------------------------
# Console level for the agentmart logger (DEBUG/INFO/WARNING/ERROR). The
# rotating file logs/agentmart.log always records DEBUG, so a postmortem never
# misses a hop even when the console is quiet. Per-run override: --log-level.
AGENTMART_LOG_LEVEL=INFO

# --- OpenAI direct (optional; takes precedence over the OPENROUTER_* values) --
# Point the lab's six agents at OpenAI's own endpoint. Set all three or none.
# gpt-5.6-luna is ~3.6x faster than qwen3.7-flash on the six-agent chain (21s vs
# 76s) but ~8x dearer per run. The client reshapes the request for this endpoint:
# max_completion_tokens instead of max_tokens, no temperature (the model rejects
# anything but its default), and reasoning_effort as a top-level parameter.
#
# NOTE: this path suits the AgentMart agents, which never call tools. Hermes does
# call tools, and gpt-5.6-luna rejects tools+reasoning together on OpenAI's
# /v1/chat/completions -- so Hermes must reach the same model through OpenRouter.
# See BENCHMARK.md.
# OPENAI_API_KEY=sk-proj-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6-luna
