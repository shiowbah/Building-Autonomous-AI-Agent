{
  "hermes_agent": {
    "id": "hermes_myshopper",
    "display_name": "Hermes / MyShopper",
    "represents": "customer",
    "description": "Personal buying agent owned by the customer. It receives chat messages and negotiates with AgentMart through A2A.",
    "channels": [
      "telegram",
      "whatsapp",
      "webchat"
    ],
    "capabilities": [
      "personal_buying_request",
      "product_preference_extraction",
      "customer_constraint_handoff",
      "agentmart_a2a_negotiation",
      "order_status_lookup",
      "checkout_initiation"
    ],
    "model": {
      "provider": "openai",
      "base_url_env": "OPENAI_BASE_URL",
      "api_key_env": "OPENAI_API_KEY",
      "model_env": "OPENAI_MODEL",
      "default_model": "gpt-5.6-luna",
      "fallback_models": [],
      "temperature": 0.2,
      "max_tokens": 6000,
      "reasoning_effort": "medium"
    }
  },
  "a2a_connection": {
    "protocol": "agentmart.a2a.v1",
    "transport": "langgraph-workshop-in-process",
    "task_endpoint": "agentmart://a2a/tasks",
    "heartbeat_stream": "agentmart.a2a.heartbeats",
    "capability_registry": "agentmart.a2a.capabilities",
    "message_ttl_seconds": 900,
    "requires_ack": true,
    "task_lifecycle": [
      "proposed",
      "accepted",
      "in_progress",
      "completed",
      "failed"
    ],
    "correlates_by": "correlation_id"
  },
  "agentmart": {
    "id": "agentmart",
    "display_name": "AgentMart Agent Ecosystem",
    "agents": [
      {
        "id": "shopping_agent",
        "capabilities": [
          "product_search",
          "candidate_shortlist"
        ]
      },
      {
        "id": "pricing_agent",
        "capabilities": [
          "price_check",
          "budget_fit",
          "value_ranking"
        ]
      },
      {
        "id": "inventory_agent",
        "capabilities": [
          "stock_check",
          "availability_risk"
        ]
      },
      {
        "id": "fulfillment_agent",
        "capabilities": [
          "delivery_options",
          "pickup_options"
        ]
      },
      {
        "id": "order_agent",
        "capabilities": [
          "order_summary",
          "checkout_next_step",
          "order_status_lookup",
          "draft_order_create"
        ]
      },
      {
        "id": "payment_agent",
        "capabilities": [
          "payment_authorize",
          "payment_capture",
          "refund_status"
        ],
        "simulated": true,
        "note": "Workshop payment agent. Writes simulated payment rows locally; contacts no payment processor."
      }
    ]
  },
  "intent_routing": {
    "browse_catalog": [
      "shopping_agent",
      "pricing_agent",
      "inventory_agent",
      "order_agent"
    ],
    "product_advice": [
      "shopping_agent",
      "pricing_agent",
      "inventory_agent",
      "fulfillment_agent",
      "order_agent"
    ],
    "purchase_intent": [
      "inventory_agent",
      "fulfillment_agent",
      "order_agent"
    ],
    "checkout_payment": [
      "order_agent",
      "payment_agent"
    ],
    "order_status": [
      "order_agent"
    ]
  }
}
